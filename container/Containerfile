FROM docker.io/library/rust:1.97-slim-bookworm AS builder

WORKDIR /source
RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in \
        amd64) echo x86_64-unknown-linux-musl > /tmp/rust-target ;; \
        arm64) echo aarch64-unknown-linux-musl > /tmp/rust-target ;; \
        *) echo "unsupported architecture" >&2; exit 1 ;; \
       esac \
    && rustup target add "$(cat /tmp/rust-target)"
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates ./crates
RUN cargo build --locked --release --target "$(cat /tmp/rust-target)" --bin vdesk \
    && install -D "target/$(cat /tmp/rust-target)/release/vdesk" /out/usr/local/bin/vdesk

FROM scratch AS artifacts

COPY --from=builder /out /

FROM docker.io/library/debian:trixie-slim AS runtime-core

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        at-spi2-core \
        python3-pyatspi \
        ca-certificates \
        dbus-daemon \
        dbus-x11 \
        fonts-dejavu-core \
        fonts-liberation \
        libgl1-mesa-dri \
        tigervnc-standalone-server \
        x11vnc \
        xclip \
        xdotool \
        xfce4-panel \
        xfce4-session \
        xfce4-settings \
        xfconf \
        xfdesktop4 \
        xfwm4 \
        xfce4-terminal \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/bash vdesk \
    && install -d -o vdesk -g vdesk -m 0700 /run/vdesk /run/vdesk/user \
    && install -d -o vdesk -g vdesk -m 0755 /workspace /downloads \
    && ln -s /usr/local/bin/vdesk /usr/local/bin/vdesk-chromium \
    && ln -s /usr/local/bin/vdesk-chromium /usr/local/bin/chromium

COPY --from=artifacts / /

ENV HOME=/home/vdesk \
    USER=vdesk \
    DISPLAY=:99 \
    VDESK_DISPLAY=:99 \
    XDG_RUNTIME_DIR=/run/vdesk/user \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/run/vdesk/bus \
    NO_AT_BRIDGE=0

USER vdesk
WORKDIR /workspace
EXPOSE 7777

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/vdesk", "serve"]

FROM runtime-core AS minimal

FROM runtime-core AS default

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium mousepad thunar \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's|Exec=/usr/bin/chromium|Exec=/usr/local/bin/vdesk-chromium|' \
        /usr/share/applications/chromium.desktop
USER vdesk
